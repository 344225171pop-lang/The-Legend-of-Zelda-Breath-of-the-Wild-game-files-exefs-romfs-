<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>BotwExtractor.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Share the Android-free UI logic with the app without referencing Android. -->
    <Compile Include="..\BotwExtractor\Ui\*.cs" Link="Ui\%(Filename)%(Extension)" />
    <!-- Section copier is pure System.* logic; shared for parallel-copy tests. -->
    <Compile Include="..\..\core\Extractor.Core\ParallelSectionCopier.cs" Link="Core\ParallelSectionCopier.cs" />
    <!-- NSZ/NCZ header validation is pure System.* + ZstdSharp; shared for robustness tests. -->
    <Compile Include="..\..\core\Extractor.Core\NszDecompressor.cs" Link="Core\NszDecompressor.cs" />
    <Compile Include="..\..\core\Extractor.Core\AesCtr.cs" Link="Core\AesCtr.cs" />
    <Compile Include="..\..\core\Extractor.Core\Progress.cs" Link="Core\Progress.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>
</Project>
