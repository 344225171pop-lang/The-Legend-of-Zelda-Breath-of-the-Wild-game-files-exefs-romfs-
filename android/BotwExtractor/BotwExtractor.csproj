<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BotwExtractor</RootNamespace>
    <AssemblyName>BotwExtractor</AssemblyName>
    <ApplicationId>com.botw.extractor</ApplicationId>
    <ApplicationTitle>BOTW Extractor</ApplicationTitle>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>1.5</ApplicationDisplayVersion>
    <JavaSdkDirectory>E:\botw_work\jdk17</JavaSdkDirectory>
    <AndroidSdkDirectory>E:\botw_work\android-sdk</AndroidSdkDirectory>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>E:\botw_work\android\botw.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>botw</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>botw123</AndroidSigningStorePass>
    <AndroidSigningKeyPass>botw123</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Extractor.Core\Extractor.Core.csproj" />
    <Reference Include="LibHac">
      <HintPath>..\..\tools\libhac_pkg\lib\net7.0\LibHac.dll</HintPath>
    </Reference>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.11.0.2" />
  </ItemGroup>
</Project>
