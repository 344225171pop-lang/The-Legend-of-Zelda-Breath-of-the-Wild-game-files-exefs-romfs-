<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>FileExportBench</RootNamespace>
    <AssemblyName>FileExportBench</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Share the exact production UI logic (no Android dependency). -->
    <Compile Include="..\..\android\BotwExtractor\Ui\*.cs" Link="Ui\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
