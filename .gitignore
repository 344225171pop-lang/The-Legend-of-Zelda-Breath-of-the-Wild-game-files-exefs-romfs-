# ---- Build artifacts ----
bin/
obj/
*.user
*.suo
.vs/

# ---- Local SDK / toolchain (large, machine-specific, not source) ----
nuget_packages/
dotnet_home/
dotnet/
jdk17/
android-sdk/
downloads/

# ---- Extraction output / scratch directories ----
out/
out_android_test/
out_android_test_temp/
nsp/

# ---- Benchmark scratch data (multi-GB, reproducible via ExtractBench --prepare) ----
perf/cache/
perf/out_serial/
perf/out_parallel/

# ---- Sensitive console keys (NEVER commit; dump from your own console) ----
prod.keys
title.keys
titlekeys.txt
*.keys

# ---- Signing material (NEVER commit; generate your own) ----
*.keystore
*.jks

# ---- Third-party tool binaries not required to build (download separately) ----
tools/hactool/
tools/hactoolnet/
tools/nsz.exe
tools/*.zip
tools/*.nupkg
tools/libhac_pkg/package/
tools/libhac_pkg/_rels/
tools/libhac_pkg/.signature.p7s
tools/libhac_pkg/\[Content_Types\].xml

# ---- OS / editor noise ----
Thumbs.db
Desktop.ini
.DS_Store
*.log